{
  "name": "dsh-conversation-digest",
  "version": "0.1.1",
  "description": "复盘你历史上的提问方式问题，发送前按这些改进项改写草稿，并把有效问法沉淀成按任务类型推荐的模板。三者共用一份个人提示词档案，档案是本机 JSON，不存密钥。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-profile.mjs && node scripts/smoke-analyze.mjs && node scripts/smoke-sessions.mjs && node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke.mjs",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "smoke:analyze": "node scripts/smoke-analyze.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:sessions": "node scripts/smoke-sessions.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "measure:tokens": "node scripts/measure-tokens.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "conversation",
    "summary",
    "digest"
  ],
  "author": "LIN-F1SH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIN-F1SH/dsh-conversation-digest.git"
  },
  "bugs": {
    "url": "https://github.com/LIN-F1SH/dsh-conversation-digest/issues"
  },
  "homepage": "https://github.com/LIN-F1SH/dsh-conversation-digest#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "docs",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
