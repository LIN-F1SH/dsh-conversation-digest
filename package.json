{
  "name": "dsh-prompt-lint",
  "version": "0.2.0",
  "description": "提示词体检：读你的历史会话找出反复踩的提问坑（缺路径、没定格式、漏前置条件），每条给可直接粘贴的改写；输入框旁一键出更短的带约束版本。不承诺提升准确度。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-profile.mjs && node scripts/smoke-analyze.mjs && node scripts/smoke-sessions.mjs && node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke.mjs",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "smoke:analyze": "node scripts/smoke-analyze.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:sessions": "node scripts/smoke-sessions.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "measure:tokens": "node scripts/measure-tokens.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "conversation",
    "summary",
    "digest"
  ],
  "author": "LIN-F1SH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIN-F1SH/dsh-prompt-lint.git"
  },
  "bugs": {
    "url": "https://github.com/LIN-F1SH/dsh-prompt-lint/issues"
  },
  "homepage": "https://github.com/LIN-F1SH/dsh-prompt-lint#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "docs",
    "icon.png",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
